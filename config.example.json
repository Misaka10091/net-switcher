      "ipv6": "enable",
      "mode": {
        "type": "dhcp",
        "renewOnSwitch": true
      }
    }
  ],
  "ui": {
    "showNotifications": true,
    "refreshIntervalSeconds": 15,
    "leftClickToggle": true
  }
}
