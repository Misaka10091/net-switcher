      "mode": {
        "type": "static",
        "ip": "192.168.1.100",
        "subnetMask": "255.255.255.0",
        "gateway": "192.168.1.2",
        "gatewayMetric": 0,
        "dns": [
          "192.168.1.1"
        ]
      }
    },
    {
      "id": "wlan-dhcp-auto",
      "name": "DHCP 自动获取",
